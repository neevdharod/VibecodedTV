<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Mirror Boost: close background apps. A normal permission, granted at install. -->
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />
    <!-- Mirror Boost: turn background Wi-Fi/Bluetooth scanning off. Granted once over ADB:
         pm grant com.vibecoded.tv android.permission.WRITE_SECURE_SETTINGS -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" xmlns:tools="http://schemas.android.com/tools" />
    <!-- Lists the apps Home can open (Android 11+; harmless on 9). -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" xmlns:tools="http://schemas.android.com/tools" />

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:label="@string/app_name"
        android:icon="@drawable/banner_home"
        android:banner="@drawable/banner_home"
        android:theme="@style/Theme.Vibecoded"
        android:hardwareAccelerated="true"
        android:largeHeap="true"
        android:usesCleartextTraffic="false"
        android:supportsRtl="true">

        <!-- The home screen. -->
        <activity
            android:name=".HomeActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:excludeFromRecents="true"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|uiMode"
            android:screenOrientation="landscape">
            <!-- No longer the TV's Home: the native launcher (launcher/) is. Kept for opening by hand. -->
        </activity>

        <!-- Queue, the movie finder. -->
        <activity
            android:name=".QueueActivity"
            android:exported="false"
            android:label="@string/queue_name"
            android:banner="@drawable/banner_queue"
            android:icon="@drawable/banner_queue"
            android:launchMode="singleTask"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|uiMode"
            android:screenOrientation="landscape">
            <!-- Replaced by the native Queue in the launcher (launcher/.../QueueActivity). -->
        </activity>

        <!-- Mirror Boost. -->
        <activity
            android:name=".MirrorActivity"
            android:exported="true"
            android:label="@string/mirror_name"
            android:banner="@drawable/banner_mirror"
            android:icon="@drawable/banner_mirror"
            android:launchMode="singleTask"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|uiMode"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
