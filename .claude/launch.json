{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "tv-sample",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "tools/serve_sample.py",
        "8765"
      ],
      "port": 8765
    },
    {
      "name": "tv-preview",
      "runtimeExecutable": "python3",
